# --- Required ---
DATABASE_URL="postgresql://user:password@localhost:5432/foreum"
BETTER_AUTH_SECRET="change-me-to-a-random-string"

# --- SMTP Email (Fallback, primary config is in Admin > Settings > Email) ---
# Settings saved in the DB take priority over these env vars.
# These env vars are only used if no DB settings exist yet.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@yourforum.com"
SMTP_PASS="your-smtp-password"
SMTP_SECURE="false"
SMTP_FROM="noreply@yourforum.com"

# --- OAuth Providers ---
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
DISCORD_CLIENT_ID="..."
DISCORD_CLIENT_SECRET="..."

# --- App ---
BASE_URL="http://localhost:3000"

# --- Optional ---
# LOG_LEVEL="debug"  # debug | info | warn | error
